# Copy to .env and adjust. Values here are the defaults used when unset.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200

LOG_LEVEL=debug

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/salary_calculator
